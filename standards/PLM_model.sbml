    <qual:listOfTransitions>
      <qual:transition qual:id="tr_Insulin">
        <qual:listOfInputs>
          <qual:input qual:id="in_Insulin_DR" qual:qualitativeSpecies="DR" qual:transitionEffect="none" qual:sign="negative"/>
          <qual:input qual:id="in_Insulin_Nutrients" qual:qualitativeSpecies="Nutrients" qual:transitionEffect="none" qual:sign="positive"/>
        </qual:listOfInputs>
        <qual:listOfOutputs>
          <qual:output qual:id="out_Insulin" qual:qualitativeSpecies="Insulin" qual:transitionEffect="assignmentLevel"/>
        </qual:listOfOutputs>
        <qual:listOfFunctionTerms>
          <qual:defaultTerm qual:resultLevel="0"/>
          <qual:functionTerm qual:resultLevel="1">
            <math xmlns="http://www.w3.org/1998/Math/MathML">
              <apply>
                <and/>
                <apply>
                  <geq/>
                  <ci> Nutrients </ci>
                  <cn type="integer"> 1 </cn>
                </apply>
                <apply>
                  <not/>
                  <apply>
                    <geq/>
                    <ci> DR </ci>
                    <cn type="integer"> 1 </cn>
                  </apply>
                </apply>
              </apply>
            </math>
          </qual:functionTerm>
        </qual:listOfFunctionTerms>
      </qual:transition>
