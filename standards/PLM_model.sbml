              </apply>
            </math>
          </qual:functionTerm>
        </qual:listOfFunctionTerms>
      </qual:transition>
      <qual:transition qual:id="tr_FGF21">
        <qual:listOfInputs>
          <qual:input qual:id="in_FGF21_DR" qual:qualitativeSpecies="DR" qual:transitionEffect="none" qual:sign="positive"/>
          <qual:input qual:id="in_FGF21_Mito_dysfunction" qual:qualitativeSpecies="Mito_dysfunction" qual:transitionEffect="none" qual:sign="positive"/>
          <qual:input qual:id="in_FGF21_PPARA" qual:qualitativeSpecies="PPARA" qual:transitionEffect="none" qual:sign="positive"/>
        </qual:listOfInputs>
        <qual:listOfOutputs>
